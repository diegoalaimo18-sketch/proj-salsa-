<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SABA LATIN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark fixed-top">
        <div class="container">
            <ul class="navbar-nav">
                <li class="nav-item">@Html.ActionLink("Active Memberships", "ListarMembresiasActivas", "Membresia", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Members", "ListarMiembros", "Membresia", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Add New Member", "RegistrarMiembro", "Miembro", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Membership History", "Historial", "Membresia", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Financial Overview", "SumaMensual", "OverallAverage", null, new { @class = "nav-link" })</li>
                <li class="nav-item">@Html.ActionLink("Logout", "Deslogueo", "Empleado", null, new { @class = "nav-link" })</li>
            </ul>
        </div>
    </nav>

    <div class="container body-content" style="margin-top: 80px">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - SABA LATIN</p>
        </footer>
    </div>
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>