@model Sitio.Models.Membresia

@{
    ViewBag.Title = "FormModificarObservacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Modify Notes</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.IdMembresia)
    <hr />

    <div class="row">
        <div class="col-md-6 col-lg-4">

            <div class="form-group">
                @Html.LabelFor(model => model.Miembro.NombreCompleto, "Name")
                <div>
                    <span class="highlighted-name">@Html.DisplayFor(model => model.Miembro.NombreCompleto)</span>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Observacion)
                @Html.EditorFor(model => model.Observacion, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Observacion, "", new { @class = "text-danger" })
            </div>

            <input type="submit" value="Save" class="btn btn-primary" />
            @Html.ActionLink("Back to List", "Historial", null, new { @class = "btn btn-secondary ml-2" })

        </div>
    </div>
}

<style>
    .highlighted-name {
        font-weight: bold;
        color: #007bff;
        font-size: 20px;
    }
</style>