@model Sitio.Models.Membresia

@{
    ViewBag.Title = "FormMembresiaEliminar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Membership</h2>

<h3 class="text-danger mb-3">Are you sure you want to delete this?</h3>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.IdMembresia)
    <hr />

    <div class="row">
        <div class="col-md-6 col-lg-5">

            <div class="card p-3 shadow-sm mb-4">
                <h4 class="card-title text-muted mb-3">Membresía</h4>

                <div class="form-group mb-2">
                    <strong>Type:</strong>
                    <span>@(Model.TipoMembresia != null ? Model.TipoMembresia.Nombre : "")</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.CantClases):</strong>
                    <span>@Html.DisplayFor(model => model.CantClases)</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.Activo):</strong>
                    <span>@Html.DisplayFor(model => model.Activo)</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.FechaInicio):</strong>
                    <span>@Html.DisplayFor(model => model.FechaInicio)</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.FechaExpiracion):</strong>
                    <span>@Html.DisplayFor(model => model.FechaExpiracion)</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.Pago):</strong>
                    <span>@Html.DisplayFor(model => model.Pago)</span>
                </div>

                <div class="form-group mb-2">
                    <strong>@Html.DisplayNameFor(model => model.Costo):</strong>
                    <span>$@Html.DisplayFor(model => model.Costo)</span>
                </div>

                <div class="form-group mb-3">
                    <strong>@Html.DisplayNameFor(model => model.Observacion):</strong>
                    <p class="mb-0 text-muted">@Html.DisplayFor(model => model.Observacion)</p>
                </div>
            </div>

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-danger" />
                @Html.ActionLink("Back to List", "Historial", null, new { @class = "btn btn-secondary ml-2" })
            </div>

        </div>
    </div>
}

<style>
    .card {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.25rem;
    }
</style>