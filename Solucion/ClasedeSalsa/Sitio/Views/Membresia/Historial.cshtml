@model IEnumerable<Sitio.Models.Membresia>

@{
    ViewBag.Title = "Historial";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Membership History</h2>

<form method="get" action="@Url.Action("FiltrarHistorial", "Membresia")" class="col-md-6 col-lg-4">
    <div class="form-group">
        <label for="searchName">Search by Name:</label>
        <input type="text" id="searchName" name="searchName" class="form-control" placeholder="Enter name" value="@Request.QueryString["searchName"]" />
    </div>

    <div class="d-flex justify-content-start">
        <button type="submit" class="btn btn-primary" style="width: auto;">Search</button>
        <a href="@Url.Action("Historial", "Membresia")" class="btn btn-secondary ml-2" style="width: auto;">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>Status</th>
            <th>Name</th>
            <th>Type</th>
            <th>Start Date</th>
            <th>Expiration Date</th>
            <th>Amount</th>
            <th>Classes</th>
            <th>Pay By</th>
            <th>Observations</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Sitio.Models.Membresia membresia in Model)
        {
            string colorClass = "";

            switch (membresia.TipoMembresia.Nombre)
            {
                case "EXPIRED":
                    colorClass = "expired";
                    break;

                case "4 Pack":
                    colorClass = "four-pack";
                    break;

                case "Unlimited/week":
                    colorClass = "unlimited-week";
                    break;

                case "Week Intro":
                    colorClass = "week-intro";
                    break;

                case "Casual":
                    colorClass = "casual";
                    break;

                case "2 times/week":
                    colorClass = "two-times-week";
                    break;

                case "Free trial":
                    colorClass = "free-trial";
                    break;

                case "10 pack":
                    colorClass = "ten-pack";
                    break;

                case "Unlimited/month":
                    colorClass = "unlimited-month";
                    break;

                default:
                    colorClass = "default";
                    break;
            }

            <tr>
                <td>
                    <span class="font-weight-bold @(membresia.Activo ? "text-primary" : "text-danger")">
                        @(membresia.Activo ? "ACTIVE" : "EXPIRED")
                    </span>
                </td>
                <td>@membresia.Miembro.NombreCompleto</td>
                <td class="@colorClass">@membresia.TipoMembresia.Nombre</td>
                <td>@membresia.FechaInicio.ToShortDateString()</td>
                <td>@membresia.FechaExpiracion.ToShortDateString()</td>
                <td>$@membresia.Costo</td>
                <td>@membresia.CantClases</td>
                <td>@membresia.Pago</td>
                <td>@membresia.Observacion</td>
                <td class="text-nowrap">
                    @Html.ActionLink("Modify Notes", "FormModificarObservacion", new { IdMembresia = membresia.IdMembresia }) |
                    @Html.ActionLink("Delete Membership", "FormMembresiaEliminar", new { IdMembresia = membresia.IdMembresia })
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .four-pack {
        background-color: #FF69B4;
    }

    .unlimited-week {
        background-color: #FF0000;
    }

    .week-intro {
        background-color: #FFA500;
    }

    .casual {
        background-color: #87CEEB;
    }

    .two-times-week {
        background-color: #5B9BD5;
    }

    .free-trial {
        background-color: #FFFFE0;
    }

    .ten-pack {
        background-color: #8A2BE2;
    }

    .unlimited-month {
        background-color: #32CD32;
    }

    .default {
        background-color: #F5F5F5;
    }

    .expired {
        color: red;
        font-weight: bold;
    }
</style>